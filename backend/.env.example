# Copy to .env and fill in values. Never commit .env to git.

# Database (required)
MONGODB_URI=
DB_NAME=

# Auth (required; use long random strings in production)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=24h

# Server
PORT=4000
NODE_ENV=production

# Email — required in production for OTP + complaint notifications
# Option A (recommended): Brevo HTTP API
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=CCMS Team

# Option B (fallback): Brevo SMTP — used if API fails (e.g. IP blocked on Render)
# Get login + SMTP key from Brevo → SMTP & API → SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: file uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: keep-alive ping (Render)
RENDER_EXTERNAL_URL=

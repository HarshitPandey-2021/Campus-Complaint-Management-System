# Copy to .env and fill in values. Never commit .env to git.

# Database (required)
MONGODB_URI=
DB_NAME=

# Auth (required; use long random strings in production)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=24h

# Server
PORT=4000
NODE_ENV=production

# Forgot-password emails (required in production for /auth/forgot-password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional: file uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: keep-alive ping (e.g. Render)
RENDER_EXTERNAL_URL=
